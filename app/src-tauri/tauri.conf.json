{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Referensia",
  "version": "1.0.5",
  "identifier": "com.referensia.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Referensia — Cari Referensi Ilmiah Otomatis",
        "width": 1100,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/referensia-server"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "nsis/hook.nsh"
      }
    }
  }
}